      "variant": "emphasis"
    },
    {
      "id": "windows-idle",
      "from": "windows",
      "to": "idle",
      "label": "outside",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "budget-spent",
      "from": "budget",
      "to": "spent",
      "label": "cap reached",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "budget-inflight",
      "from": "budget",
      "to": "inflight",
      "label": "1. advance first",
      "variant": "emphasis"
    },
    {
      "id": "budget-candidates",
      "from": "budget",
      "to": "candidates",
      "label": "2. then triage",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "inflight-dispatch",
      "from": "inflight",
      "to": "dispatch",
      "variant": "emphasis"
    },
    {
      "id": "dispatch-stations",
      "from": "dispatch",
      "to": "stations",
      "label": "lease + execute window",
      "variant": "emphasis"
    },
    {
      "id": "candidates-known",
      "from": "candidates",
      "to": "known"
    },
    {
      "id": "known-triage",
      "from": "known",
      "to": "do_triage",
      "label": "never seen"
    },
    {
      "id": "known-orphan",
      "from": "known",
      "to": "orphan",
      "label": "in flight elsewhere",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Tick and exit",
      "items": [
        "Every task advances by at most one step per tick",
        "Nothing blocks on CI, on a reviewer, or on a human",
        "A closed laptop costs one step, never a ticket"
      ]
    },
    {
      "dot": "amber",
      "title": "Ordering is deliberate",
      "items": [
        "Cheap no-LLM bookkeeping runs before any new triage",
        "Budget is re-checked before every single agent run",
        "A crash on one row records last_error and the tick continues"
      ]
    },
    {
      "dot": "rose",
      "title": "Kill switches",
      "items": [
        "runner.mode shadow triages and comments but writes no code",
        "The per-ticket no-ai tag removes one ticket from the funnel",
        "cli._tick_all swallows per-source errors so one workspace cannot stop the rest"
      ]
    }
  ]
}