  "cards": [
    {
      "dot": "rose",
      "title": "Hard rules beat the model",
      "items": [
        "Prod data, migrations, auth, payments, secrets and infra go to human-only",
        "Prompt-injection shapes in a ticket body are treated the same way",
        "Human comment text is scanned too; bot comments are not"
      ]
    },
    {
      "dot": "cyan",
      "title": "Triage never reads the repo",
      "items": [
        "reason() runs one turn with an empty tool allowlist",
        "It runs in a fixed empty triage_dir, so no repo CLAUDE.md leaks in",
        "doctor proves the isolation with a canary prompt, and fails if unverified"
      ]
    },
    {
      "dot": "amber",
      "title": "Routing and the gate",
      "items": [
        "One ticket can need two repos, and gets one independent row each",
        "With a single candidate repo the model is not consulted at all",
        "Re-triage keeps the existing repo set so no branch is stranded"
      ]
    }
  ]
