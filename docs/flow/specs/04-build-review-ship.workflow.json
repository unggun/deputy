    {
      "id": "fix-pr",
      "from": "fix",
      "to": "pr_open",
      "label": "fixes pushed",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "review-blocked",
      "from": "review",
      "to": "blocked",
      "label": "rejected or exhausted",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "pr-blocked",
      "from": "pr_open",
      "to": "blocked",
      "label": "PR closed",
      "variant": "security",
      "role": "error"
