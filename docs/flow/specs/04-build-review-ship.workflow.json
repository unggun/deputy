  "cards": [
    {
      "dot": "cyan",
      "title": "One agent per repo",
      "items": [
        "Two agents on one base branch produce conflicting PRs",
        "review and pr-open hold a slot but release the repo lock",
        "A ticket spanning two repos spends one slot in each"
      ]
    },
    {
      "dot": "amber",
      "title": "Budgets that actually bite",
      "items": [
        "attempts resets to 0 on every clean hand-off between stations",
        "An expired lease on in-progress means a dead run, and requeues",
        "max_review_cycles is authoritative over max_fix_attempts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Only an approving review writes to the brain",
      "items": [
        "Notes are appended before the PR is even opened",
        "A rejected plan, a rejected review or a crash writes nothing",
        "At brain_max_bytes it stops appending rather than forgetting"
      ]
    }
  ]
}