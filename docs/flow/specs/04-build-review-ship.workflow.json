      "fromCol": 1,
      "toCol": 2,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "queued",
    "implement",
    "push",
    "review",
    "pr_open",
    "done"
  ],
  "nodes": [
    {
      "id": "queued",
      "lane": "build",
      "col": 0,
