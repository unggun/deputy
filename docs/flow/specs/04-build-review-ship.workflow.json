      "to": "push",
      "label": "diff produced",
      "variant": "emphasis"
    },
    {
      "id": "push-review",
      "from": "push",
      "to": "review",
      "label": "branch pushed",
      "variant": "emphasis"
    },
    {
      "id": "review-pr",
      "from": "review",
      "to": "pr_open",
      "label": "approved",
      "variant": "emphasis"
    },
    {
      "id": "pr-done",
      "from": "pr_open",
      "to": "done",
