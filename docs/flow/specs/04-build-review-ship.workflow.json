{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Zoom: Queued to Merged",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy",
        "label": "Straight through",
        "focus": [
          "queued",
          "implement",
          "push",
          "review",
          "pr_open",
          "done"
        ],
        "note": "Each hop is one tick; nothing waits inside a tick."
      },
      {
        "id": "revision",
        "label": "Revision loop",
        "focus": [
          "review",
          "queued",
          "implement"
        ],
        "note": "A reviewer asking for changes sends the row back for another implementation pass."
      },
      {
        "id": "escalation",
        "label": "Escalation paths",
        "focus": [
          "push",
          "review",
          "pr_open",
          "blocked"
        ],
        "note": "Every dead end is an explicit comment on the ticket, never a silent stall."
      }
    ]
  },
  "lanes": [
    {
      "id": "build",
      "label": "Implementer station"
    },
    {
      "id": "judge",
      "label": "Reviewer station"
    },
    {
      "id": "ship",
      "label": "Pull request and CI"
    },
    {
      "id": "stop",
      "label": "Escalated to a human",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "write_phase",
      "label": "Write the code",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "ship_phase",
      "label": "Judge it, then ship it",
      "fromCol": 3,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "groups": [
    {
      "id": "under_lease",
      "label": "one agent per repo, under a lease",
