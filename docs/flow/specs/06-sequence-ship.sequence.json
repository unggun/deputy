  "cards": [
    {
      "dot": "cyan",
      "title": "The agent never touches git",
      "items": [
        "Prompts forbid committing, pushing and opening a PR",
        "Worktrees live under work_dir, never in your own checkout",
        "GIT_DIR and friends are stripped from the child environment"
      ]
    },
    {
      "dot": "amber",
      "title": "Review comes before the PR",
      "items": [
        "A rejected branch never becomes a pull request at all",
        "request_changes sends the row back to queued for another pass",
        "Only an approving review appends to the per-repo brain"
      ]
    },
    {
      "dot": "rose",
      "title": "Polling is never waiting",
      "items": [
        "Pending CI simply ends the tick; the next tick looks again",
        "Only allowlisted reviewers count as human feedback",
        "A closed PR, or exhausted fix attempts, escalates to a human"
      ]
    }
  ]
}
