    { "participant": "agent", "from": 165, "to": 233, "type": "messagebus" },
    { "participant": "pipeline", "from": 290, "to": 358, "type": "backend" },
    { "participant": "agent", "from": 290, "to": 329, "type": "messagebus" },
    { "participant": "pipeline", "from": 386, "to": 483, "type": "backend" },
    { "participant": "github", "from": 348, "to": 454, "type": "frontend" }
