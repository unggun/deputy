    { "id": "push", "from": "pipeline", "to": "git", "y": 257, "label": "commit_all + push, no PR yet", "variant": "default" },
    { "id": "review", "from": "pipeline", "to": "agent", "y": 295, "label": "work(): judge diff against criteria", "variant": "emphasis" },
    { "id": "approved", "from": "agent", "to": "pipeline", "y": 324, "label": "approve, plus notes for the brain", "variant": "return" },
    { "id": "openpr", "from": "pipeline", "to": "github", "y": 353, "label": "gh pr create --draft", "variant": "emphasis" },
